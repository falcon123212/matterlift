# Meta Model API (OpenAI-compatible). Copy to .env and fill in.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Model names: overridable, filled in from scripts/smoke_meta.py output
META_MODEL_SPARK=muse-spark-1.3
META_MODEL_IMAGE=muse-image-1.0
META_MODEL_SAM=sam-3.1
META_MODEL_TRANSCRIBE=muse-voice-transcribe-1.0
# Route for Muse Voice Transcribe (the OpenAI-style one 404s as of 2026-11-01)
META_TRANSCRIBE_PATH=/audio/transcriptions
